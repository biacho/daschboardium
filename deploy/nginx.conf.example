# Dashboardium — tylko LAN. Nie wystawiaj na publiczny interfejs.
#
# Nie binduj listen do adresu LAN (np. listen 192.168.1.10:80). To tworzy osobny
# socket; ruch z NAT-u (w tym HTTP-01 Let's Encrypt dla innych vhostów)
# wpada wtedy tylko do bloków na tym adresie. Izolację robią allow/deny.
#
# Dostosuj: server_name, alias / SCRIPT_FILENAME, ewentualnie prefiks URL.

server {
    listen 80;
    server_name dashboard.lan;

    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.1;
    deny all;

    location = /dashboard {
        return 301 /dashboard/;
    }

    location /dashboard/ {
        alias /var/www/dashboardium/;
        index index.php;

        location ~ /\. {
            deny all;
            access_log off;
            log_not_found off;
        }
    }

    # Sekrety, cache, zależność, skrypty tylko-CLI
    location ~ ^/dashboard/(config\.php|config\.example\.php|cache_[^/]+\.json|composer\.(json|lock)|vendor/|install\.php|usage-snapshot\.php) {
        deny all;
        return 404;
    }

    location ~ ^/dashboard/(.+\.php)$ {
        alias /var/www/dashboardium/$1;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/dashboardium/$1;
        include fastcgi_params;
    }
}
