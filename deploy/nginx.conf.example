# Nie binduj listen do adresu LAN — izolację robią allow/deny.
# Dostosuj: server_name, alias, SCRIPT_FILENAME.

server {
    listen 80;
    server_name dashboard.lan;

    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.1;
    deny all;

    location = /dashboard {
        return 301 /dashboard/;
    }

    location /dashboard/ {
        alias /var/www/dashbordium/;
        index index.php;

        location ~ /\. {
            deny all;
            access_log off;
            log_not_found off;
        }
    }

    location ~ ^/dashboard/(config/|var/|bin/|lib/|vendor/|composer\.(json|lock)|install\.php) {
        deny all;
        return 404;
    }

    location ~ ^/dashboard/(.+\.php)$ {
        alias /var/www/dashbordium/$1;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/dashbordium/$1;
        include fastcgi_params;
    }
}
