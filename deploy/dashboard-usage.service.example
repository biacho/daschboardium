[Unit]
Description=Dashbordium — snapshot zużycia Claude / Grok
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/php /var/www/dashbordium/bin/usage-snapshot.php --loop=60
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
